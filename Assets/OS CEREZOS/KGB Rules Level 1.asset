%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 41f33ff2bf902304eb4748cd9b7e84ba, type: 3}
  m_Name: KGB Rules Level 1
  m_EditorClassIdentifier: 
  rules:
  - input: T(w;L)
    output: F(w;0.3)T(w+trunkIncrement; L+trunkLengthIncrement)
    condition: w < maxTrunkWidth
    weight: 1
  - input: T(w;L)
    output: F(w;0.3)[ P(w*branchTaper ; branchStartL ; 0) ]   [+(branchAngle) P(w*branchTaper
      ; branchStartL ; 0)] [-(branchAngle) P(w*branchTaper ; branchStartL ; 0)] [^(branchAngle)
      P(w*branchTaper ; branchStartL ; 0)] [&(branchAngle) P(w*branchTaper ; branchStartL
      ; 0)]
    condition: w >= maxTrunkWidth
    weight: 1
  - input: P(w;L;a)
    output: F(w;branchGrowth)P(w*branchTaper; L+branchGrowth; a)
    condition: ' L < maxBranchLength'
    weight: 1
  - input: P(w;L;a)
    output: F(w;branchGrowth) [S(w*branchTaper ; branchStartL*secScale ; 0) ][+(branchAngle)
      S(w*branchTaper ; branchStartL ; 0)] [-(branchAngle) S(w*branchTaper ; branchStartL
      ; 0)] [^(branchAngle) S(w*branchTaper ; branchStartL ; 0)] [&(branchAngle)
      S(w*branchTaper ; branchStartL ; 0)] P(w*branchTaper ; L+branchGrowth ; a+1)
    condition: L >= maxBranchLength && a < 2
    weight: 1
  - input: P(w;L;a)
    output: F(w;branchGrowth)P(w;branchStartL;0)
    condition: a >= 2
    weight: 1
  - input: S(w;L;a)
    output: F(w;branchGrowth)S(w*branchTaper; L+branchGrowth; a)
    condition: ' L < maxBranchLength'
    weight: 1
  - input: S(w;L;a)
    output: F(w;branchGrowth) [+(branchAngle) S(w*branchTaper ; branchStartL*secScale
      ; 0)] [-(branchAngle) S(w*branchTaper ; branchStartL*secScale ; 0)] [^(branchAngle)
      S(w*branchTaper ; branchStartL*secScale ; 0)] [&(branchAngle) S(w*branchTaper
      ; branchStartL*secScale ; 0)] S(w*branchTaper ; L*secScale ; a+1)
    condition: L >= maxBranchLength &&  a < 2
    weight: 1
  - input: S(w;L;a)
    output: ' F(w;branchGrowth)'
    condition: ' a >= 2'
    weight: 1
  generalVariables:
  - variable: maxTrunkWidth
    value: 0.2
  - variable: trunkIncrement
    value: 0.04
  - variable: trunkLengthIncrement
    value: 0.5
  - variable: branchStartW
    value: 0.04
  - variable: branchStartL
    value: 0.4
  - variable: branchTaper
    value: 0.7
  - variable: branchGrowth
    value: 0.6
  - variable: maxBranchLength
    value: 0.6
  - variable: branchAngle
    value: 25
  - variable: secScale
    value: 1.5
  isStochastic: 0
